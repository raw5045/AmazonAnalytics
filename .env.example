# ============== APP ==============
APP_PUBLIC_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============== NEON ==============
# Get from neon.tech dashboard → Connection Details → pooled connection string
DATABASE_URL=

# ============== CLERK ==============
# Get from clerk.com dashboard → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Get from clerk.com dashboard → Webhooks → after creating endpoint
CLERK_WEBHOOK_SIGNING_SECRET=

# ============== CLOUDFLARE R2 ==============
# Get from Cloudflare dashboard → R2 → Manage R2 API Tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=amazon-sfr-analytics-dev

# ============== INNGEST ==============
# Optional for local dev (the Inngest dev server runs without keys)
# Required in production — get from inngest.com dashboard
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ============== ADMIN BOOTSTRAP ==============
# Email of the user to promote to admin on first sign-in
INITIAL_ADMIN_EMAIL=

# ============== RESEND (email) ==============
# Get from resend.com → API Keys. Unset = every send is skipped with a warning (fine in local dev).
RESEND_API_KEY=
# From address for transactional email; defaults to KeywordQuarry <notifications@keywordquarry.com>
RESEND_FROM=
# Contact sync: the Resend Segment (Contacts → Segments → open it → copy the id)
# that every new member is added to, and removed from when their account is
# deleted. Unset = contact sync off. See lib/notifications/resendContacts.ts
# Needs a Full access API key: a "Sending access" key fails contact calls with restricted_api_key.
RESEND_SEGMENT_ID=

# ============== MCP (external AI clients: claude.ai, ChatGPT) ==============
# The /api/mcp endpoint is dark (404) unless MCP_ENABLED=1.
# See docs/superpowers/specs/2026-09-19-mcp-spike-design.md
MCP_ENABLED=
# Who may connect: admin (default) or all
MCP_AUDIENCE=
# Comma-separated Clerk OAuth application client ids; empty = any client of this Clerk instance
MCP_ALLOWED_CLIENT_IDS=
# Canonical resource URL of the endpoint; defaults to APP_PUBLIC_URL + /api/mcp (an override must keep the /api/mcp path)
MCP_RESOURCE_URL=
# Shown on the Connect AI page to signed-in, eligible accounts so members can
# paste them into claude.ai / ChatGPT (the pair identifies the client app, not
# the user; the account sign-in is the gate). Copy each from the Clerk OAuth
# application. Unset = the page tells members to ask for it via Feedback.
MCP_CLIENT_SECRET_CLAUDE=
MCP_CLIENT_SECRET_CHATGPT=

# ============== RESEARCH SERVICE (MCP tools) ==============
# HMAC key for search cursors; unset = derived from CLERK_SECRET_KEY. Set a random 32+ char value before the beta rollout.
RESEARCH_CURSOR_SECRET=
# Optional JSON overriding runtime limits (positive integers only; unknown keys ignored with a warning), e.g. {"requestsPerMinute":120}. See lib/research/limits.ts
RESEARCH_LIMITS_JSON=

# ============== ASK AI (in-app research chat) ==============
# The /ask tab and /api/ask/* routes are dark unless ASK_AI_ENABLED=1. To stop Ask AI for
# everyone at any time, unset this.
# See docs/superpowers/specs/2026-09-28-in-app-chat-design.md
ASK_AI_ENABLED=
# Server-side Anthropic API key (owner sets it in Vercel; never commit a real key).
ANTHROPIC_API_KEY=
# Questions per member per UTC day; a whole number above 0 (default 100). An invalid value is
# ignored, the default is used, and a warning is logged (visible in the Vercel logs in production).
ASK_AI_DAILY_MESSAGE_LIMIT=
# Total model cost across ALL accounts per month; everyone stops when reached (default 200). A
# plain number, no "$"; 0 pauses Ask AI for everyone. An invalid value is ignored, the default is
# used, and a warning is logged. Sizing hint: set the ceiling above the allowances you have
# granted plus your own testing.
ASK_AI_GLOBAL_MONTHLY_CEILING_USD=
# Optional per-model rate overrides. See lib/ask/pricing.ts; rates (input, cacheWrite,
# cacheRead, output) in $ per million tokens; estimatePerQuestionMicro in micro-dollars per
# question (40000 = 4¢); the example equals today's Sonnet 5 defaults.
# ASK_AI_PRICES_JSON={"claude-sonnet-5":{"input":2,"cacheWrite":2.5,"cacheRead":0.2,"output":10,"estimatePerQuestionMicro":40000}}
ASK_AI_PRICES_JSON=
# Monthly allowance (model cost, USD) a newly granted member starts with (default 10). A plain
# number, no "$"; 0 grants access with no included usage. An invalid value is ignored, the
# default is used, and a warning is logged.
ASK_AI_DEFAULT_ALLOWANCE_USD=
